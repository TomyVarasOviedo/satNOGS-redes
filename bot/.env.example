# Token que entrega @BotFather
TELEGRAM_BOT_TOKEN=
# Opcional: si lo dejás vacío, se usa/crea CHAT_ID_FILE y se actualiza al último chat que hable
TELEGRAM_CHAT_ID=
# Archivo de texto donde se guarda el chat id (por defecto bot/chat_id.txt)
CHAT_ID_FILE=
# URL del backend FastAPI
BACKEND_URL=http://127.0.0.1:8000
# Minutos de anticipación de la alerta de pase inminente
ALERT_LEAD_MIN=120
# Cada cuántos minutos se buscan pases inminentes
PASS_SCAN_INTERVAL_MIN=1
# Intervalo de escaneo en modo prueba (segundos)
TEST_SCAN_SECONDS=5
# Anticipación de la alerta en modo prueba (minutos; por defecto igual a ALERT_LEAD_MIN)
TEST_LEAD_MIN=120
# Hora UTC del resumen diario
AGENDA_HOUR_UTC=9
# Días de antigüedad del TLE a partir de los cuales se avisa
TLE_MAX_AGE_DAYS=7
# Elevación mínima para considerar un pase en agenda y alertas
MIN_ELEVATION_DEG=10
# Zona horaria para mostrar las horas locales (además de UTC)
TZ=America/Argentina/Buenos_Aires
# Archivo de estado para no repetir alertas (por defecto bot/state.json)
STATE_PATH=
